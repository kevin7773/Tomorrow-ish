---
interface Props {
	message?: string | null;
	error?: string | null;
}

const { message, error } = Astro.props;
const messages: Record<string, string> = {
	'intake-created': 'Source intake created.',
	'intake-updated': 'Source intake updated.',
	'reference-added': 'Source reference added.',
	'reference-updated': 'Source reference updated.',
	'candidate-created': 'Satire candidate created as a draft.',
	'candidate-updated': 'Candidate draft updated.',
	'candidate-transitioned': 'Candidate status updated.',
	'candidate-converted': 'Approved candidate converted to a draft story.',
	'story-updated': 'Story draft updated.',
	'story-transitioned': 'Story status updated.',
	'story-published': 'Story published by explicit editorial authority.',
	'normalization-proposed': 'A model normalization proposal was recorded for human review.',
	'normalization-revised': 'An editor-authored normalized-event version was created.',
	'normalization-accepted': 'The normalized-event version was accepted.',
	'normalization-rejected': 'The normalized-event version was rejected.',
	'normalization-superseded': 'The accepted normalized-event version was superseded.',
	'candidates-generated': 'Five model candidates were created as DRAFT records.',
};
const errors: Record<string, string> = {
	'invalid-request': 'The request was not valid. Review the fields and try again.',
	'not-found': 'The requested editorial record was not found.',
	'duplicate': 'That conversion has already occurred.',
	'conflict': 'The record changed before this action completed. Reload and try again.',
	'provider-unavailable': 'The model provider could not be reached. No editorial content was created.',
	'provider-rejected': 'The model provider rejected the request. No editorial content was created.',
	'provider-invalid-output': 'The model provider returned an invalid response. No editorial content was created.',
	'model-budget': 'The configured model budget does not permit this request. No editorial content was created.',
	'model-disabled': 'Model generation is disabled or is not configured. No editorial content was created.',
	'operation-failed': 'The editorial operation could not be completed.',
};
---

{message && messages[message] && <p class="editorial-alert editorial-alert--success" role="status">{messages[message]}</p>}
{error && errors[error] && <p class="editorial-alert editorial-alert--error" role="alert">{errors[error]}</p>}
