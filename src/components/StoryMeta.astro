---
import { formatEditionDate } from '../lib/dates';

interface Props {
	category: string;
	categorySlug: string;
	editionDate: string;
}

const { category, categorySlug, editionDate } = Astro.props;
---

<p class="story-meta">
	<a href={`/category/${categorySlug}`}>{category}</a>
	<span aria-hidden="true">•</span>
	<time datetime={editionDate}>{formatEditionDate(editionDate)} edition</time>
</p>
