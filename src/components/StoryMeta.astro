---
import { formatEditionDate } from '../lib/dates';

interface Props {
	category: string;
	editionDate: string;
}

const { category, editionDate } = Astro.props;
---

<p class="story-meta">
	<span>{category}</span>
	<span aria-hidden="true">•</span>
	<time datetime={editionDate}>{formatEditionDate(editionDate)} edition</time>
</p>
