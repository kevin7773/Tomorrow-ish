---
interface Props {
	format?: 'leaderboard' | 'in-feed' | 'sidebar';
}

const { format = 'leaderboard' } = Astro.props;
---

<aside class:list={['ad-slot', `ad-slot--${format}`]} aria-label="Advertisement placeholder">
	<span>Advertisement</span>
	<p aria-hidden="true">A quiet space reserved for a future sponsor.</p>
</aside>
