---
import { env } from 'cloudflare:workers';
import {
	ADSENSE_PUBLISHER_ID,
	getAdSenseSlot,
	isAdsEnabled,
	type AdPlacement,
} from '../ads/adsense';

interface Props {
	placement: AdPlacement;
	format?: 'inline' | 'sidebar';
}

const { placement, format = 'inline' } = Astro.props;
const slot = getAdSenseSlot(env, placement);
const shouldRender = isAdsEnabled(env) && slot !== null;
---

{shouldRender && (
	<aside class:list={['ad-slot', `ad-slot--${format}`]} aria-label="Advertisement" data-ad-placement={placement}>
		<span class="ad-slot__label">Advertisement</span>
		<ins
			class="adsbygoogle"
			style="display:block"
			data-ad-client={ADSENSE_PUBLISHER_ID}
			data-ad-slot={slot}
			data-ad-format="auto"
			data-full-width-responsive="true"
		></ins>
		<script is:inline>
			window.adsbygoogle = window.adsbygoogle || [];
			window.adsbygoogle.push({});
		</script>
	</aside>
)}
