---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = true;
---

<SiteLayout
	title="Terms"
	description="Terms of use for Tomorrow-ish."
	canonicalPath="/terms"
>
	<header class="page-header">
		<p class="section-kicker">Terms of an approximate future</p>
		<h1>Terms</h1>
		<p>Effective September 10, 2026</p>
	</header>

	<article class="prose-page">
		<p class="prose-page__standfirst">Read freely, share responsibly, and remember that tomorrow is fictional here.</p>
		<h2>Satirical content</h2>
		<p>
			Tomorrow-ish publishes fictional satire for entertainment and commentary. Its stories are not factual news
			reports and should not be treated as professional, financial, legal, medical, or other advice.
		</p>
		<h2>Use of the site</h2>
		<p>
			You may browse and link to public pages for lawful purposes. Do not interfere with the site, attempt to bypass
			its security, or present its fictional stories as authentic reporting.
		</p>
		<h2>External material</h2>
		<p>
			Links to outside sources are supplied for context. Tomorrow-ish does not control or endorse all content on those
			sites and is not responsible for their availability.
		</p>
		<h2>Availability</h2>
		<p>
			The site may change, disappear, reappear, or become slightly more tomorrow-like without notice. These terms may
			also be revised as the publication develops.
		</p>
		<h2>Changes to these terms</h2>
		<p>Any material revision will appear on this page with a new effective date.</p>
	</article>
</SiteLayout>
