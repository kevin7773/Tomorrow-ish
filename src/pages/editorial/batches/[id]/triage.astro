---
import EditorialMessage from '../../../../components/EditorialMessage.astro';
import { getEditorialRepository } from '../../../../data/runtime-editorial-repository';
import { getEditorialWorkflowRepository } from '../../../../data/runtime-editorial-workflow-repository';
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';

const batchId = Astro.params.id ?? '';
const batch = await getEditorialWorkflowRepository().findBatch(batchId);
if (!batch) return Astro.redirect('/editorial/batches?error=not-found');
const pending = batch.items.filter((item) => item.state === 'INGESTED');
const editorial = getEditorialRepository();
const categories = new Map((await editorial.listCategories()).map((category) => [category.id, category.name]));
const intakes = (await Promise.all(pending.map(async (item) => ({ item, intake: await editorial.findIntakeById(item.intakeId) }))))
	.filter((entry) => entry.intake !== null);
const csrfToken = Astro.locals.csrfToken;
---

<EditorialLayout title="Intake triage">
	<div class="editorial-page-header"><div><p class="section-kicker">Gate 1 · Batch {batch.id}</p><h1>Intake triage</h1><p>{pending.length} of {batch.itemCount} intake{batch.itemCount === 1 ? '' : 's'} still need a Generate or Reject decision.</p></div><a class="editorial-button editorial-button--quiet" href="/editorial/batches">All batches</a></div>
	<EditorialMessage message={Astro.url.searchParams.get('message')} error={Astro.url.searchParams.get('error')} />
	{pending.length === 0 ? <section class="editorial-panel"><h2>Triage complete</h2><p>Selected items are proceeding through normalization, headline, body, and image generation without another human gate.</p><a class="editorial-button" href={`/editorial/batches/${batch.id}/review`}>View generation progress</a></section> :
	<form method="post" action="/editorial/actions/workflow-triage">
		<input type="hidden" name="csrf_token" value={csrfToken} /><input type="hidden" name="batchId" value={batch.id} />
		<div class="editorial-list">{intakes.map(({ item, intake }) => intake && <article class="editorial-panel"><label><input type="checkbox" name="intakeId" value={intake.id} /> <strong>{intake.title}</strong></label><p>{intake.neutralBrief}</p>{intake.references.map((reference) => <p><strong>{reference.publisherName}</strong> · <a href={reference.sourceUrl} target="_blank" rel="noopener noreferrer">{reference.sourceTitle} ↗</a></p>)}<p><strong>Proposed category:</strong> {categories.get(item.categoryId) ?? item.categoryId} · Ingested {new Date(intake.createdAt).toLocaleString('en-US')}</p></article>)}</div>
		<div class="editorial-form__actions"><button class="editorial-button" name="decision" value="SELECT" type="submit">Generate selected</button><button class="editorial-button editorial-button--danger" name="decision" value="REJECT" type="submit" data-confirm="Reject the selected intakes without generating articles?">Reject selected</button></div>
	</form>}
	<script>
		document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((button) => button.addEventListener('click', (event) => { if (!window.confirm(button.dataset.confirm)) event.preventDefault(); }));
	</script>
</EditorialLayout>
