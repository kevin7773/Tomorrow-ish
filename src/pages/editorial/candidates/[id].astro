---
import EditorialMessage from '../../../components/EditorialMessage.astro';
import { CANDIDATE_STATUSES, canTransitionCandidate } from '../../../domain/editorial';
import { getEditorialRepository } from '../../../data/runtime-editorial-repository';
import { getGenerationRepository } from '../../../data/runtime-generation-repository';
import { isRuntimeModelGenerationAvailable } from '../../../ai/runtime-model-provider';
import { hasAuthoritativeFactSupport } from '../../../domain/generation';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';

const id = Astro.params.id ?? '';
const repository = getEditorialRepository();
const [candidate, categories] = await Promise.all([
	repository.findCandidateById(id),
	repository.listCategories(),
]);
if (!candidate) return Astro.redirect('/editorial/candidates?error=not-found');
const bodyGenerationContext = await getGenerationRepository().findCandidateForBodyGeneration(candidate.id);
const auditEntries = await repository.listAuditEntries('SATIRE_CANDIDATE', candidate.id);
const csrfToken = Astro.locals.csrfToken;
const returnPath = `/editorial/candidates/${candidate.id}`;
const nextStatuses = CANDIDATE_STATUSES.filter((status) => canTransitionCandidate(candidate.status, status));
const suggestedSlug = candidate.proposedHeadline
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-|-$/g, '')
	.slice(0, 120)
	.replace(/-$/g, '');
const tomorrow = new Date();
tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);
const modelGenerationAvailable = isRuntimeModelGenerationAvailable();
const acceptedFacts = bodyGenerationContext?.version?.assertions.filter((assertion) => assertion.kind === 'FACT') ?? [];
const bodyGenerationSourceEligible = Boolean(
	bodyGenerationContext?.version
	&& bodyGenerationContext.version.reviewState === 'ACCEPTED'
	&& bodyGenerationContext.version.id === candidate.normalizedEventVersionId
	&& bodyGenerationContext.version.sourceIntakeId === bodyGenerationContext.intake.id
	&& bodyGenerationContext.intake.references.length > 0
	&& acceptedFacts.length > 0
	&& acceptedFacts.every((assertion) => hasAuthoritativeFactSupport(assertion, bodyGenerationContext.intake.references))
	&& bodyGenerationContext.intake.assessmentReviewedAt
	&& ['SUITABLE', 'SENSITIVE'].includes(bodyGenerationContext.intake.satireSuitability)
	&& (bodyGenerationContext.intake.satireSuitability !== 'SENSITIVE' || candidate.editorialNotes.trim()),
);
---

<EditorialLayout title={candidate.proposedHeadline}>
	<div class="editorial-page-header">
		<div>
			<p class="section-kicker">{candidate.category.name} · Candidate {candidate.status}</p>
			<h1>{candidate.proposedHeadline}</h1>
			<p>Derived from <a href={`/editorial/intakes/${candidate.sourceIntakeId}`}>{candidate.sourceIntakeTitle}</a>.</p>
		</div>
		<span class:list={['editorial-badge', { 'editorial-badge--approved': candidate.status === 'APPROVED' }]}>{candidate.status}</span>
	</div>
	<EditorialMessage message={Astro.url.searchParams.get('message')} error={Astro.url.searchParams.get('error')} />
	<section class="editorial-provenance" aria-label="Candidate provenance">
		<p><strong>{candidate.originKind === 'MODEL' ? 'Model-generated' : 'Editor-authored'} candidate</strong>{candidate.generationOrdinal ? ` · Alternative ${candidate.generationOrdinal}` : ''}</p>
		{candidate.rationale && <p><strong>Rationale:</strong> {candidate.rationale}</p>}
		{candidate.satiricalMechanism && <p><strong>Satirical mechanism:</strong> {candidate.satiricalMechanism}</p>}
		{candidate.originModelRunId && <p><a href={`/editorial/model-runs/${candidate.originModelRunId}`}>Open provider, cost, and generation provenance</a></p>}
		{candidate.normalizedEventVersionId && <p>Normalized-event version: <code>{candidate.normalizedEventVersionId}</code></p>}
		{candidate.bodyGenerationRunId && candidate.bodyGenerationState !== 'PENDING' && <p><a href={`/editorial/model-runs/${candidate.bodyGenerationRunId}`}>Open article-body generation provenance</a></p>}
	</section>

	{candidate.convertedStoryId ? (
		<div class="editorial-alert editorial-alert--success">
			This approved candidate is immutable. <a href={`/editorial/stories/${candidate.convertedStoryId}`}>Open its draft story</a>.
		</div>
	) : (
		<>
			{candidate.status === 'DRAFT' && !candidate.draftBodyMarkdown.trim() && (
				<section class="editorial-panel" aria-labelledby="body-generation-heading">
					<h2 id="body-generation-heading">Generate article body</h2>
					{candidate.bodyGenerationState === 'PENDING' ? (
						<>
							<p class="editorial-alert">Article body generation is in progress. Another request cannot be submitted.</p>
							<form class="editorial-form" method="post" action="/editorial/actions/generation">
								<input type="hidden" name="csrf_token" value={csrfToken} />
								<input type="hidden" name="action" value="resolve-body-pending" />
								<input type="hidden" name="candidateId" value={candidate.id} />
								<input type="hidden" name="returnPath" value={returnPath} />
								<p class="editorial-form__help">If the request remains pending after one hour, close it without contacting the provider so a deliberate manual retry can be requested.</p>
								<button class="editorial-button editorial-button--quiet" type="submit">Resolve stale request</button>
							</form>
						</>
					) : !bodyGenerationSourceEligible ? (
						<p class="editorial-alert editorial-alert--error">This candidate does not have the reviewed source authority required for body generation.</p>
					) : (
						<form class="editorial-form" method="post" action="/editorial/actions/generation">
							<input type="hidden" name="csrf_token" value={csrfToken} />
							<input type="hidden" name="action" value="generate-body" />
							<input type="hidden" name="candidateId" value={candidate.id} />
							<input type="hidden" name="idempotencyKey" value={`body:${candidate.id}:${crypto.randomUUID()}`} />
							<input type="hidden" name="returnPath" value={returnPath} />
							<p>Uses persisted source facts, governance, and the selected candidate framing. It will not change status or overwrite an existing body.</p>
							<button class="editorial-button" type="submit" disabled={!modelGenerationAvailable}>{modelGenerationAvailable ? 'Generate article body' : 'Article body generation disabled'}</button>
							{!modelGenerationAvailable && <p class="editorial-form__help">No production newsroom model is configured; article body generation is disabled.</p>}
						</form>
					)}
				</section>
			)}
			<form class="editorial-form editorial-panel" method="post" action="/editorial/actions/candidates">
				<input type="hidden" name="csrf_token" value={csrfToken} />
				<input type="hidden" name="action" value="update" />
				<input type="hidden" name="id" value={candidate.id} />
				<input type="hidden" name="returnPath" value={returnPath} />
				<label><span>Proposed headline</span><input name="proposedHeadline" value={candidate.proposedHeadline} maxlength="300" required /></label>
				<label><span>Proposed deck</span><textarea name="proposedDeck" maxlength="1000" required>{candidate.proposedDeck}</textarea></label>
				<label><span>Draft body in Markdown</span><textarea class="editorial-form__body" name="draftBodyMarkdown" maxlength="50000" required>{candidate.draftBodyMarkdown}</textarea></label>
				<label><span>Category</span><select name="categoryId" required>{categories.map((category) => <option value={category.id} selected={category.id === candidate.category.id}>{category.name}</option>)}</select></label>
				<label><span>Editorial notes</span><textarea name="editorialNotes" maxlength="20000">{candidate.editorialNotes}</textarea></label>
				<button class="editorial-button" type="submit">Save candidate</button>
			</form>

			{nextStatuses.length > 0 && (
				<section class="editorial-panel" aria-labelledby="candidate-status-heading">
					<h2 id="candidate-status-heading">Review state</h2>
					<div class="editorial-form__actions">
						{nextStatuses.map((status) => (
							<form method="post" action="/editorial/actions/candidates">
								<input type="hidden" name="csrf_token" value={csrfToken} />
								<input type="hidden" name="action" value="transition" />
								<input type="hidden" name="id" value={candidate.id} />
								<input type="hidden" name="to" value={status} />
								<input type="hidden" name="returnPath" value={returnPath} />
								<button class="editorial-button editorial-button--quiet" type="submit">Move to {status}</button>
							</form>
						))}
					</div>
				</section>
			)}

			{candidate.status === 'APPROVED' && (
				<section class="editorial-panel" aria-labelledby="convert-heading">
					<h2 id="convert-heading">Create a draft story</h2>
					<p>Conversion creates exactly one DRAFT story. It cannot publish.</p>
					<form class="editorial-form" method="post" action="/editorial/actions/convert">
						<input type="hidden" name="csrf_token" value={csrfToken} />
						<input type="hidden" name="candidateId" value={candidate.id} />
						<input type="hidden" name="returnPath" value={returnPath} />
						<label><span>Story slug</span><input name="slug" value={suggestedSlug} maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /></label>
						<label><span>Edition date</span><input type="date" name="editionDate" value={tomorrow.toISOString().slice(0, 10)} required /></label>
						<label><span>Social excerpt</span><textarea name="socialExcerpt" maxlength="500" required>{candidate.proposedDeck}</textarea></label>
						<button class="editorial-button" type="submit">Convert to DRAFT story</button>
					</form>
				</section>
			)}
		</>
	)}

	<section class="editorial-panel" aria-labelledby="audit-heading">
		<h2 id="audit-heading">Audit history</h2>
		<table class="editorial-audit"><thead><tr><th>Time</th><th>Action</th><th>Actor</th><th>State</th><th>Reason</th></tr></thead><tbody>{auditEntries.map((entry) => <tr><td>{new Date(entry.createdAt).toLocaleString('en-US')}</td><td>{entry.action}</td><td>{entry.actorEmail}</td><td>{entry.fromStatus && entry.toStatus ? `${entry.fromStatus} → ${entry.toStatus}` : entry.toStatus ?? '—'}</td><td>{entry.reason ?? '—'}</td></tr>)}</tbody></table>
	</section>
</EditorialLayout>
