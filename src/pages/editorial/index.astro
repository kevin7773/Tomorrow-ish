---
import EditorialMessage from '../../components/EditorialMessage.astro';
import { getEditorialRepository } from '../../data/runtime-editorial-repository';
import { getReviewNotificationRepository } from '../../data/runtime-review-notification-repository';
import EditorialLayout from '../../layouts/EditorialLayout.astro';

const counts = await getEditorialRepository().getDashboardCounts();
const notifications = await getReviewNotificationRepository().listDelivered(5);
---

<EditorialLayout title="Editorial desk">
	<div class="editorial-page-header">
		<div>
			<h1>Editorial desk</h1>
			<p>Human selection starts generation; explicit final review remains the only path to publication.</p>
		</div>
		<a class="editorial-button" href="/editorial/intakes/new">Record a source event</a>
	</div>
	<EditorialMessage message={Astro.url.searchParams.get('message')} error={Astro.url.searchParams.get('error')} />
	{notifications.length > 0 && <section class="editorial-panel" aria-labelledby="notification-heading">
		<div class="editorial-page-header"><div><h2 id="notification-heading">Review notifications</h2><p>Latest notices delivered by the internal Worker receiver.</p></div><a class="editorial-button editorial-button--quiet" href="/editorial/notifications">View all</a></div>
		<div class="editorial-list">{notifications.map((notification) => <article class="editorial-list__item">
			<div><strong>{notification.message}</strong><p>{new Date(notification.createdAt).toLocaleString('en-US')}</p></div>
			{notification.reviewUrl && <a class="editorial-button" href={notification.reviewUrl}>Open review</a>}
		</article>)}</div>
	</section>}
	<section class="editorial-stats" aria-label="Editorial queue summary">
		<a class="editorial-stat" href="/editorial/intakes">
			<strong>{counts.intakes}</strong>
			<span>source intakes</span>
		</a>
		<a class="editorial-stat" href="/editorial/candidates">
			<strong>{counts.candidatesInReview}</strong>
			<span>candidates in review</span>
		</a>
		<a class="editorial-stat" href="/editorial/candidates">
			<strong>{counts.approvedCandidates}</strong>
			<span>approved candidates to convert</span>
		</a>
		<a class="editorial-stat" href="/editorial/stories">
			<strong>{counts.storiesAwaitingPublication}</strong>
			<span>stories awaiting publication</span>
		</a>
	</section>
	<section class="editorial-panel" aria-labelledby="authority-heading">
		<h2 id="authority-heading">Publication authority</h2>
		<p>The normal workflow has two human gates: intake triage and final package review. Normalization, headline, body, and image generation run automatically between them. Publication always requires an authenticated editor's explicit action.</p>
		<a class="editorial-button" href="/editorial/batches">Open batch review</a>
	</section>
</EditorialLayout>
