---
import { SATIRE_SUITABILITIES, SOURCE_TIERS, SOURCE_TYPES } from '../../../domain/editorial';
import EditorialLayout from '../../../layouts/EditorialLayout.astro';

const csrfToken = Astro.locals.csrfToken;
---

<EditorialLayout title="New source intake">
	<div class="editorial-page-header">
		<div>
			<h1>Record a source event</h1>
			<p>Write a neutral fact pattern. Do not copy the source headline’s framing, editorial adjectives, or pundit reaction.</p>
		</div>
	</div>
	<form class="editorial-form editorial-panel" method="post" action="/editorial/actions/intakes">
		<input type="hidden" name="csrf_token" value={csrfToken} />
		<input type="hidden" name="action" value="create" />
		<input type="hidden" name="returnPath" value="/editorial/intakes/new" />
		<label>
			<span>Event title</span>
			<input name="title" maxlength="240" required />
		</label>
		<label>
			<span>Neutral factual brief</span>
			<textarea name="neutralBrief" maxlength="20000" required placeholder={'FACT PATTERN:\n- Organization announced X.\n- Change takes effect on Y.\n- Stated purpose is Z.'}></textarea>
			<p class="editorial-form__help">Summarize facts only. Source material remains separate below.</p>
		</label>
		<div class="editorial-form__row">
			<label><span>Significance score</span><select name="significanceScore" required>{[1,2,3,4,5].map((value) => <option value={value}>{value}</option>)}</select></label>
			<label><span>Satire-potential score</span><select name="satirePotentialScore" required>{[1,2,3,4,5].map((value) => <option value={value}>{value}</option>)}</select></label>
		</div>
		<label><span>Satire suitability</span><select name="satireSuitability" required>{SATIRE_SUITABILITIES.map((value) => <option value={value}>{value}</option>)}</select></label>
		<label><span>Editorial notes</span><textarea name="editorialNotes" maxlength="20000"></textarea></label>

		<h2>Initial source authority</h2>
		<label><span>Source title</span><input name="sourceTitle" maxlength="500" required /></label>
		<div class="editorial-form__row">
			<label><span>Source URL</span><input type="url" name="sourceUrl" maxlength="2048" required /></label>
			<label><span>Publisher or authority</span><input name="publisherName" maxlength="240" required /></label>
		</div>
		<div class="editorial-form__row">
			<label><span>Source tier</span><select name="sourceTier" required>{SOURCE_TIERS.map((value) => <option value={value}>{value}</option>)}</select></label>
			<label><span>Source type</span><select name="sourceType" required>{SOURCE_TYPES.map((value) => <option value={value}>{value}</option>)}</select></label>
		</div>
		<label><span>Source publication time (optional)</span><input type="datetime-local" name="publishedAt" /></label>
		<div class="editorial-form__actions">
			<button class="editorial-button" type="submit">Create source intake</button>
			<a href="/editorial/intakes">Cancel</a>
		</div>
	</form>
</EditorialLayout>
