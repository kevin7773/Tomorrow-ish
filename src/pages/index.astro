---
import AdSlot from '../components/AdSlot.astro';
import EmptyEdition from '../components/EmptyEdition.astro';
import StoryCard from '../components/StoryCard.astro';
import { getStoryRepository } from '../data/runtime-story-repository';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatEditionDate } from '../lib/dates';

const repository = getStoryRepository();
const leadStory = await repository.getLeadStory();
const recentStories = leadStory
	? await repository.listPublished({ excludeId: leadStory.id, limit: 6 })
	: [];
---

<SiteLayout canonicalPath="/">
	{leadStory ? (
		<>
			<div class="edition-line">
				<span>Tomorrow’s edition</span>
				<time datetime={leadStory.editionDate}>{formatEditionDate(leadStory.editionDate)}</time>
			</div>

			<section class="lead-grid" aria-labelledby="tomorrows-headline">
				<div class="lead-grid__story">
					<h1 id="tomorrows-headline" class="section-kicker">Tomorrow’s headline</h1>
					<StoryCard story={leadStory} prominent />
				</div>
				<aside class="lead-grid__rail" aria-label="More from Tomorrow-ish">
					<p class="section-kicker">Elsewhere in the edition</p>
					{recentStories.slice(0, 2).map((story) => <StoryCard story={story} compact />)}
					<AdSlot format="sidebar" />
				</aside>
			</section>

			<AdSlot format="leaderboard" />

			{recentStories.length > 0 && (
				<section aria-labelledby="recent-heading">
					<div class="section-heading">
						<h2 id="recent-heading">Recently, tomorrow</h2>
						<a href="/latest">All headlines</a>
					</div>
					<div class="story-grid">
						{recentStories.slice(2).map((story) => <StoryCard story={story} />)}
					</div>
				</section>
			)}

			<AdSlot format="in-feed" />

			<section class="archive-promo" aria-labelledby="archive-promo-heading">
				<p class="section-kicker">Every prediction, carefully preserved</p>
				<h2 id="archive-promo-heading">Yesterday's tomorrows remain on the record.</h2>
				<p>Browse complete editions by date, from the nearly plausible to the administratively inevitable.</p>
				<a class="text-link" href="/archive">Explore the archive <span aria-hidden="true">→</span></a>
			</section>
		</>
	) : (
		<EmptyEdition />
	)}
</SiteLayout>
