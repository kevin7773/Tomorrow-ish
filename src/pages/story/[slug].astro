---
import AdSlot from '../../components/AdSlot.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';
import StoryCard from '../../components/StoryCard.astro';
import StoryMeta from '../../components/StoryMeta.astro';
import { getStoryRepository } from '../../data/runtime-story-repository';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { renderStoryMarkdown } from '../../lib/markdown';
import { absoluteSiteUrl, serializeJsonLd } from '../../lib/metadata';

const slug = Astro.params.slug ?? '';
const repository = getStoryRepository();
const story = await repository.findPublishedBySlug(slug);
const relatedStories = story
	? await repository.listPublished({ excludeId: story.id, limit: 3 })
	: [];

if (!story) Astro.response.status = 404;

const articleJsonLd = story
	? serializeJsonLd({
		'@context': 'https://schema.org',
		'@type': 'SatiricalArticle',
		headline: story.headline,
		description: story.socialExcerpt,
		datePublished: story.publishedAt,
		dateModified: story.publishedAt,
		mainEntityOfPage: absoluteSiteUrl(`/story/${story.slug}`),
		publisher: {
			'@type': 'Organization',
			name: 'Tomorrow-ish',
			url: absoluteSiteUrl('/'),
		},
		isAccessibleForFree: true,
		genre: 'Satire',
		...(story.ogImageKey ? { image: absoluteSiteUrl(`/media/${story.ogImageKey}`) } : {}),
	})
	: null;
---

<SiteLayout
	title={story?.headline ?? 'Page not found'}
	description={story?.socialExcerpt ?? 'This Tomorrow-ish page has not happened yet.'}
	canonicalPath={story ? `/story/${story.slug}` : '/404'}
	type={story ? 'article' : 'website'}
	imageUrl={story?.ogImageKey ? `/media/${story.ogImageKey}` : null}
	noindex={!story}
	publishedAt={story?.publishedAt}
	section={story?.category.name}
	tags={story?.tags}
>
	{story && articleJsonLd ? (
		<>
			<script is:inline type="application/ld+json" set:html={articleJsonLd} />
			<article>
				{story.ogImageKey && story.imageAltText && <img class="article-hero" src={`/media/${story.ogImageKey}`} alt={story.imageAltText} />}
				<header class="article-header">
					<StoryMeta category={story.category.name} editionDate={story.editionDate} />
					<h1>{story.headline}</h1>
					<p class="article-deck">{story.deck}</p>
				</header>

				<div class="article-layout">
					<div class="article-body" set:html={renderStoryMarkdown(story.bodyMarkdown)} />

					<aside class="article-context" aria-label="Story context">
					<section class="source-list" aria-labelledby="source-heading">
						<h2 id="source-heading">Source and context</h2>
						{story.sources.length ? (
							<ul>
								{story.sources.map((source) => (
									<li>
										<a href={source.url} rel="noopener noreferrer">{source.title}</a>
										{source.publisher && ` — ${source.publisher}`}
									</li>
								))}
							</ul>
						) : (
							<p>This wholly fictional story has no external source material attached.</p>
						)}
					</section>
					<section class="article-disclosure" aria-labelledby="article-disclosure-heading">
						<h2 id="article-disclosure-heading">A note from the future</h2>
						<p>This article is satire. Its people, events, quotations, and institutions are fictional.</p>
					</section>
					</aside>
				</div>
			</article>

			<AdSlot format="leaderboard" />

			{relatedStories.length > 0 && (
				<section aria-labelledby="related-heading">
					<div class="section-heading">
						<h2 id="related-heading">More from the near future</h2>
						<a href="/latest">Latest headlines</a>
					</div>
					<div class="story-grid">
						{relatedStories.map((relatedStory) => <StoryCard story={relatedStory} />)}
					</div>
				</section>
			)}
		</>
	) : (
		<NotFoundContent />
	)}
</SiteLayout>
