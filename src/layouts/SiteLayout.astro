---
import { env } from 'cloudflare:workers';
import { ADSENSE_PUBLISHER_ID, shouldLoadAdSense, type AdPlacement } from '../ads/adsense';
import Masthead from '../components/Masthead.astro';
import SatireNotice from '../components/SatireNotice.astro';
import { buildPageMetadata, serializeJsonLd } from '../lib/metadata';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	type?: 'website' | 'article';
	imageUrl?: string | null;
	noindex?: boolean;
	publishedAt?: string;
	section?: string;
	tags?: string[];
	adPlacements?: AdPlacement[];
}

const metadata = buildPageMetadata(Astro.props);
const { noindex = false, publishedAt, section, tags = [], adPlacements = [] } = Astro.props;
const loadAdSense = shouldLoadAdSense(env, adPlacements);
const publicationJsonLd = serializeJsonLd({
	'@context': 'https://schema.org',
	'@type': 'NewsMediaOrganization',
	name: 'Tomorrow-ish',
	url: 'https://tomorrow-ish.news/',
	description: "Tomorrow's news. Approximately. A clearly labeled satirical newspaper.",
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={metadata.description} />
		<meta name="google-adsense-account" content={ADSENSE_PUBLISHER_ID} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		<link rel="canonical" href={metadata.canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{metadata.title}</title>

		<meta property="og:site_name" content="Tomorrow-ish" />
		<meta property="og:type" content={metadata.openGraphType} />
		<meta property="og:title" content={metadata.title} />
		<meta property="og:description" content={metadata.description} />
		<meta property="og:url" content={metadata.canonicalUrl} />
		<meta property="og:locale" content="en_US" />
		{metadata.imageUrl && <meta property="og:image" content={metadata.imageUrl} />}
		{publishedAt && <meta property="article:published_time" content={publishedAt} />}
		{section && <meta property="article:section" content={section} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<meta name="twitter:card" content={metadata.imageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={metadata.title} />
		<meta name="twitter:description" content={metadata.description} />
		{metadata.imageUrl && <meta name="twitter:image" content={metadata.imageUrl} />}
		{loadAdSense && (
			<script
				is:inline
				async
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`}
				crossorigin="anonymous"
			></script>
		)}
		<script is:inline type="application/ld+json" set:html={publicationJsonLd} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<Masthead />
			<SatireNotice />
			<main id="main-content">
				<slot />
			</main>
			<footer class="site-footer">
				<div>
					<strong>TOMORROW-ISH</strong>
					<p>Tomorrow's news. Approximately.</p>
				</div>
				<nav aria-label="Footer navigation">
					<a href="/about">About</a>
					<a href="/privacy">Privacy</a>
					<a href="/terms">Terms</a>
				</nav>
				<p class="site-footer__disclosure">All stories are fictional satire. © {new Date().getUTCFullYear()} Tomorrow-ish.</p>
			</footer>
		</div>
	</body>
</html>
