{
  "name": "tomorrow-ish",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "types": "wrangler types --include-runtime false",
    "check": "astro check",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "astro": "7.3.2",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260910.1",
    "@types/node": "24.13.4",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
