{
  "name": "tomorrow-ish",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "types": "wrangler types --include-runtime false",
    "check": "astro check",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "deploy": "node ./scripts/release/refuse-direct-deploy.mjs",
    "release:prepare": "node ./scripts/release/prepare-release.mjs",
    "release:validate": "node ./scripts/release/validate-release.mjs --config dist/server/wrangler.json --package-dir .release/wrangler-dry-run",
    "release:cron:pause-config": "node ./scripts/release/cron-config.mjs pause",
    "release:cron:restore-config": "node ./scripts/release/cron-config.mjs restore",
    "release:operator": "node ./scripts/release/operator.mjs",
    "release:resend-secrets": "powershell -NoProfile -File ./scripts/release/provision-resend-secrets.ps1",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "astro": "7.3.2",
    "fast-xml-parser": "5.11.1",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260910.1",
    "@types/node": "24.13.4",
    "es-module-lexer": "2.3.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
