{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomorrow-ish",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tomorrow-ish",
      "database_id": "local"
    }
  ],
  "observability": {
    "enabled": true
  }
}
